# TV Python Scanners - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# Telegram Bot (REQUIRED)
# Get token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Get chat_id from @userinfobot
TELEGRAM_CHAT_ID=your_numeric_chat_id_here

# Optional: Data source
# true = nsepython (NSE India), false = yfinance
USE_NSEPYTHON=true

# Optional: Custom universe (comma-separated)
# SCAN_UNIVERSE=RELIANCE,HDFCBANK,ICICIBANK,BAJFINANCE,TRENT,DMART