
//@version=5
indicator("15m Intraday Scalper", shorttitle="15m Scalp", overlay=true, max_labels_count=500)

// =============================================================================
// 15-MINUTE INTRADAY SCALPER — Designed for Groww (₹35K budget, 1-2% targets)
// Uses session-based lookbacks (NOT daily-period counts)
// =============================================================================

// =============================================================================
// INPUTS
// =============================================================================
// EMAs
emaFast   = input.int(9,   "Fast EMA",   minval=1)
emaMid    = input.int(21,  "Mid EMA",    minval=1)
emaSlow   = input.int(50,  "Slow EMA",   minval=1)
emaTrend  = input.int(200, "Trend EMA",  minval=1)

// RSI
rsiLen    = input.int(14, "RSI Length", minval=1)
rsiLow    = input.int(45, "RSI Lower Bound", minval=0, maxval=100)
rsiHigh   = input.int(68, "RSI Upper Bound", minval=0, maxval=100)

// VWAP
useVWAP   = input.bool(true, "Use VWAP for Entry Filter")

// Volume
volMult   = input.float(1.2, "Volume Spike Multiplier", minval=0.5, maxval=5.0)

// Targets & Stop (in %)
targetPct = input.float(1.5, "Target %", minval=0.1, maxval=10) / 100
stopPct   = input.float(0.8, "Stop Loss %", minval=0.1, maxval=10) / 100

// Visual
showLabels   = input.bool(true, "Show Buy/Sell Labels")
showEMAs     = input.bool(true, "Show EMAs")
showTargets  = input.bool(true, "Show Target/Stop Lines")

// =============================================================================
// CALCULATIONS
// =============================================================================

// Session-based anchors (reset each trading day)
isNewSession = ta.change(time("D")) != 0
var float sessHigh = na
var float sessLow  = na
var float sessVol  = na

if isNewSession
    sessHigh := high
    sessLow  := low
    sessVol  := volume
else
    sessHigh := math.max(sessHigh, high)
    sessLow  := math.min(sessLow, low)
    sessVol  := sessVol + volume

// EMAs
emaF = ta.ema(close, emaFast)
emaM = ta.ema(close, emaMid)
emaS = ta.ema(close, emaSlow)
emaT = ta.ema(close, emaTrend)

// VWAP (session anchored)
vwap = ta.vwap(close)

// RSI
rsi = ta.rsi(close, rsiLen)

// Volume
volAvg = ta.sma(volume, 20)
volSpike = volume > volAvg * volMult

// Price action
bullishCandle = close > open
bearishCandle = close < open
greenBar = close >= open

// =============================================================================
// BUY CONDITIONS (Scalp Long)
// =============================================================================

// 1. Trend filter: price above slow EMA (or EMA alignment mildly bullish)
cond1 = close > emaS

// 2. Fast EMA above Mid EMA (short-term uptrend)
cond2 = emaF > emaM

// 3. Pullback to VWAP or EMA support
cond3 = useVWAP ? (close <= vwap * 1.002 and close >= emaM * 0.998) : (close >= emaM * 0.998 and close <= emaM * 1.01)

// 4. RSI in sweet spot (not overbought, not oversold)
cond4 = rsi >= rsiLow and rsi <= rsiHigh

// 5. RSI rising (momentum up)
cond5 = rsi > rsi[1]

// 6. Volume confirmation (optional spike or at least average)
cond6 = volume >= volAvg * 0.8

// 7. Bullish candle (close > open)
cond7 = bullishCandle

// 8. Not at session high (avoid buying top)
cond8 = close < sessHigh * 0.995

buyCondition = cond1 and cond2 and cond3 and cond4 and cond5 and cond6 and cond7 and cond8

// =============================================================================
// SELL CONDITIONS (Scalp Short or Exit)
// =============================================================================

// 1. Bearish reversal: fast EMA crosses below mid EMA
sellCross = ta.crossunder(emaF, emaM)

// 2. RSI overbought and turning down
sellRSI = rsi > rsiHigh and rsi < rsi[1]

// 3. Price closes below VWAP (lost support)
sellVWAP = useVWAP ? close < vwap * 0.998 : false

// 4. Bearish candle at resistance
sellResist = bearishCandle and close >= sessHigh * 0.99

sellCondition = sellCross or sellRSI or sellVWAP or sellResist

// =============================================================================
// PLOTTING
// =============================================================================

// EMAs
plot(showEMAs ? emaF : na, "EMA 9",   color=color.new(color.blue, 0),   linewidth=1)
plot(showEMAs ? emaM : na, "EMA 21",  color=color.new(color.orange, 0), linewidth=1)
plot(showEMAs ? emaS : na, "EMA 50",  color=color.new(color.red, 0),    linewidth=2)
plot(showEMAs ? emaT : na, "EMA 200", color=color.new(color.purple, 0), linewidth=1, style=plot.style_line)

// VWAP
plot(useVWAP ? vwap : na, "VWAP", color=color.new(color.teal, 0), linewidth=2, style=plot.style_line)

// Buy Signal
plotshape(buyCondition and showLabels, "Buy", location=location.belowbar, color=color.new(color.green, 0), style=shape.labelup, text="▲ BUY", textcolor=color.white, size=size.normal)

// Sell Signal
plotshape(sellCondition and showLabels, "Sell", location=location.abovebar, color=color.new(color.red, 0), style=shape.labeldown, text="▼ SELL", textcolor=color.white, size=size.normal)

// =============================================================================
// TARGET / STOP LINES (based on last entry)
// =============================================================================
var float entryPrice = na
if buyCondition and na(entryPrice)
    entryPrice := close

var float targetLine = na
var float stopLine   = na

if not na(entryPrice)
    targetLine := entryPrice * (1 + targetPct)
    stopLine   := entryPrice * (1 - stopPct)
    if close >= targetLine or close <= stopLine
        entryPrice := na
        targetLine := na
        stopLine   := na

plot(showTargets and not na(targetLine) ? targetLine : na, "Target", color=color.new(color.green, 0), linewidth=1, style=plot.style_line)
plot(showTargets and not na(stopLine) ? stopLine : na, "Stop", color=color.new(color.red, 0), linewidth=1, style=plot.style_line)

// =============================================================================
// DEBUG TABLE
// =============================================================================
var table t = table.new(position.top_right, 2, 12, bgcolor=color.new(color.black, 80), border_width=1)

if barstate.islast
    table.cell(t, 0, 0, "15m SCALPER", bgcolor=color.new(color.blue, 70), text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, "", bgcolor=color.new(color.blue, 70))
    table.cell(t, 0, 1, "EMA 9/21", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 1, emaF > emaM ? "Bull ✓" : "Bear ✗", text_color=emaF > emaM ? color.green : color.red, text_size=size.tiny)
    table.cell(t, 0, 2, "Price > EMA50", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 2, cond1 ? "Yes ✓" : "No ✗", text_color=cond1 ? color.green : color.red, text_size=size.tiny)
    table.cell(t, 0, 3, "Near VWAP/EMA", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 3, cond3 ? "Yes ✓" : "No ✗", text_color=cond3 ? color.green : color.red, text_size=size.tiny)
    table.cell(t, 0, 4, "RSI (14)", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 4, str.tostring(rsi, "#.##"), text_color=cond4 ? color.green : color.red, text_size=size.tiny)
    table.cell(t, 0, 5, "RSI Momentum", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 5, cond5 ? "Rising ✓" : "Falling ✗", text_color=cond5 ? color.green : color.red, text_size=size.tiny)
    table.cell(t, 0, 6, "Volume", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 6, volSpike ? "Spike ✓" : "Avg", text_color=volSpike ? color.green : color.gray, text_size=size.tiny)
    table.cell(t, 0, 7, "Bull Candle", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 7, cond7 ? "Yes ✓" : "No ✗", text_color=cond7 ? color.green : color.red, text_size=size.tiny)
    table.cell(t, 0, 8, "BUY SIGNAL", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 8, buyCondition ? "✓ ACTIVE" : "—", text_color=buyCondition ? color.green : color.gray, text_size=size.tiny)
    table.cell(t, 0, 9, "SELL SIGNAL", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 9, sellCondition ? "✓ TRIGGERED" : "—", text_color=sellCondition ? color.red : color.gray, text_size=size.tiny)
    table.cell(t, 0, 10, "Session High", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 10, str.tostring(sessHigh, "#.##"), text_color=color.white, text_size=size.tiny)
    table.cell(t, 0, 11, "Session Low", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 11, str.tostring(sessLow, "#.##"), text_color=color.white, text_size=size.tiny)

// =============================================================================
// ALERTS
// =============================================================================
alertcondition(buyCondition, title="15m Scalper BUY", message="15m Scalper: BUY {{ticker}} @ {{close}}")
alertcondition(sellCondition, title="15m Scalper SELL", message="15m Scalper: SELL {{ticker}} @ {{close}}")